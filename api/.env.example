# Local defaults for the API. Copy to .env (gitignored): cp .env.example .env
# Values are used by make (-include .env) and by the API. No quotes around values.
PORT=8080
DATABASE_URL=postgres://wuppa:wuppa@localhost:5432/wuppa?sslmode=disable
# Replace with 32+ random bytes, base64 (openssl rand -base64 32)
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
# Optional: push is disabled with a warning log if empty
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=wuppa-poc
LOG_LEVEL=info
# Mailpit locally (web UI on http://localhost:8025). Empty disables reset emails
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Wuppa <no-reply@example.eu>
TRUSTED_PROXY_HOPS=0
